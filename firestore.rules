rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedGoogleUser() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verifiedGoogleUser() &&
        exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email));
    }

    function isTeacher() {
      return isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/teacherAccess/$(request.auth.uid)));
    }

    function validMetrics(metrics) {
      return metrics is map &&
        metrics.keys().hasOnly(['think', 'safe', 'responsibility']) &&
        metrics.think is int && metrics.think >= 0 && metrics.think <= 100 &&
        metrics.safe is int && metrics.safe >= 0 && metrics.safe <= 100 &&
        metrics.responsibility is int &&
        metrics.responsibility >= 0 && metrics.responsibility <= 100;
    }

    function validGameRecord() {
      return request.resource.data.keys().hasOnly([
          'id', 'studentCode', 'completedAt', 'scenarioOrder', 'responses',
          'finalMetrics', 'resultTitle', 'submittedBy', 'schemaVersion', 'createdAt'
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 40 &&
        request.resource.data.studentCode is string &&
        request.resource.data.studentCode.size() >= 1 &&
        request.resource.data.studentCode.size() <= 20 &&
        request.resource.data.completedAt is string &&
        request.resource.data.scenarioOrder is list &&
        request.resource.data.scenarioOrder.size() == 3 &&
        request.resource.data.responses is list &&
        request.resource.data.responses.size() == 3 &&
        validMetrics(request.resource.data.finalMetrics) &&
        request.resource.data.resultTitle is string &&
        request.resource.data.resultTitle.size() <= 20 &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time;
    }

    function validTeacherRequest() {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'status', 'requestedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.photoURL is string &&
        request.resource.data.photoURL.size() <= 500 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt == request.time;
    }

    function validSettings() {
      return request.resource.data.keys().hasOnly([
          'enabledIds', 'requiredId', 'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.enabledIds is list &&
        request.resource.data.enabledIds.size() >= 3 &&
        request.resource.data.enabledIds.size() <= 7 &&
        request.resource.data.requiredId is string &&
        request.resource.data.requiredId.size() <= 3 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    match /gameRecords/{recordId} {
      allow create: if signedIn() && recordId == request.resource.data.id && validGameRecord();
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    match /publicSettings/{documentId} {
      allow read: if signedIn();
      allow write: if isTeacher() && documentId == 'game' && validSettings();
    }

    match /teacherRequests/{teacherId} {
      allow create: if verifiedGoogleUser() && teacherId == request.auth.uid && validTeacherRequest();
      allow get: if isAdmin() || (signedIn() && teacherId == request.auth.uid);
      allow list, update, delete: if isAdmin();
    }

    match /teacherAccess/{teacherId} {
      allow get: if isAdmin() || (signedIn() && teacherId == request.auth.uid);
      allow list, create, update, delete: if isAdmin();
    }

    match /adminEmails/{email} {
      allow get: if isAdmin() || (verifiedGoogleUser() && email == request.auth.token.email);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
